#: ../hoot-theme/admin/about.php:464
msgid "Setup Frontpage and Blog Page"
msgstr ""

#: ../hoot-theme/admin/about.php:466
#, php-format
msgid ""
"By default WordPress displays blog posts on the frontpage.%9$s%9$sHowever many users want a dedicated frontpage to welcome visitors and a separate page to display their blog posts. To set this up, follow these steps:%9$s%1$s\n"
"\t\t\t%3$sIn your wp-admin area, click %11$sPages > Add New%12$s%4$s\n"
"\t\t\t%3$sGive page a Title %7$s(lets call it \"My Home Page\")%8$s%4$s\n"
"\t\t\t%3$sIn the %5$sPage Attributes%6$s option box, click the %5$sTemplate%6$s dropdown option and select %5$sWidgetized Template%6$s%4$s\n"
"\t\t\t%3$sClick on %5$sPublish%6$s for this page.%4$s\n"
"\t\t\t%3$sIn your wp-admin area, click %11$sPages > Add New%12$s%4$s\n"
"\t\t\t%3$sGive page a Title %7$s(lets call it \"My Blog\")%8$s and %5$sPublish%6$s%4$s\n"
"\t\t\t%3$sIn your wp-admin area, go to %10$sSettings > Reading%12$s%4$s\n"
"\t\t\t%3$sSelect the %5$sStatic Page%6$s option.%4$s\n"
"\t\t\t%3$sSelect the pages you created in Step 2 and 6 above.%4$s\n"
"\t\t\t%3$s%5$sSave%6$s the Changes.%4$s\n"
"\t\t\t%2$s"
msgstr ""

#: ../hoot-theme/admin/about.php:488
msgid "Setup Main Navigation Menu"
msgstr ""

#: ../hoot-theme/admin/about.php:490
#, php-format
msgid ""
"%1$s\n"
"\t\t\t%3$sIn your wp-admin, go to %10$sAppearance > Menus%12$s%4$s\n"
"\t\t\t%3$sClick on %5$screate a new menu%6$s link. %9$s%7$s(If you already have an existing menu, jump to Step 6)%8$s%4$s\n"
"\t\t\t%3$sGive your menu a name and click %5$sCreate Menu%6$s%4$s\n"
"\t\t\t%3$sNow add pages, categories, custom links etc to this menu.%4$s\n"
"\t\t\t%3$sClick %5$sSave Menu%6$s%4$s\n"
"\t\t\t%3$sClick %11$sManage Locations%12$s tab at the top%4$s\n"
"\t\t\t%3$sSelect the menu you just created in the dropdown options.%4$s\n"
"\t\t\t%3$sClick %5$sSave Changes%6$s%4$s\n"
"\t\t\t%2$s%7$sTip: You can add \"My Home Page\" and \"My Blog\" pages created in above section to your menu.%8$s\n"
"\t\t\t"
msgstr ""

#: ../hoot-theme/admin/about.php:510
msgid "Add Content to Frontpage"
msgstr ""

#: ../hoot-theme/admin/about.php:512
#, php-format
msgid ""
"%1$s\n"
"\t\t\t%3$sFollow the steps above to first create a %5$sHome Page%6$s using the %5$sWidgetized Template%6$s%4$s\n"
"\t\t\t%3$sIn your wp-admin, go to %10$sAppearance > Widgets%12$s%4$s\n"
"\t\t\t%3$sAdd Widgets to the %5$sWidgetized Template Areas%6$s%4$s\n"
"\t\t\t%3$sYou can further manage Widgetized Template modules in your wp-admin by going to %11$sAppearance > Customizer%12$s and click %5$sWidgetized Template Modules%6$s section.%4$s\n"
"\t\t\t%2$s\n"
"\t\t\t%9$s%9$s\n"
"\t\t\t%13$sAdd a full width slider%14$s\n"
"\t\t\tYou can display a full width slider on your frontpage by going to %11$sAppearance > Customizer > Widgetized Template Slider%12$s section and selecting the %5$sfull width%6$s option.\n"
"\t\t\t"
msgstr ""

